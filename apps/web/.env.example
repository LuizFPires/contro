# Supabase — projeto de desenvolvimento (preencha com os seus)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# pdf-service (boletim/ata em PDF). Sem isto, o app usa window.print().
# Ex.: http://localhost:4300 no dev. O serviço precisa liberar esta origem no CORS.
VITE_PDF_SERVICE_URL=

# Web Push do boletim (chave pública VAPID). Sem isto, a opção de push não aparece.
# Gere com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Sentry (opcional no dev)
VITE_SENTRY_DSN=
